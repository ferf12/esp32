# Copia questo file in .env e inserisci i valori reali.
# .env non e versionato.

# Password dell'utente root di MySQL
MYSQL_ROOT_PASSWORD=cambia-questa-password

# Credenziali con cui il backend si connette a MySQL
DB_USER=root
DB_PASSWORD=cambia-questa-password

# Server SMTP per l'invio delle email (Gmail richiede una App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tuo-indirizzo@example.com
SMTP_PASS=la-tua-app-password
MAIL_FROM=tuo-indirizzo@example.com

# Chiave di firma degli access token, almeno 32 caratteri
JWT_SECRET=cambia-questa-chiave-segreta-con-una-lunga-almeno-32-caratteri
